+ExpectedStmt ASTNodeImporter::VisitOMPBarrierDirective(OMPBarrierDirective *S) {
+  Error Err = Error::success();
+  auto ToStart = importChecked(Err, S->getBeginLoc());
+  auto ToEnd = importChecked(Err, S->getEndLoc());
+  if (Err)
+    return std::move(Err);
+
+  return OMPBarrierDirective::Create(Importer.getToContext(), ToStart, ToEnd);
+}
+
+ExpectedStmt ASTNodeImporter::VisitOMPSingleDirective(OMPSingleDirective *S) {
+  Error Err = Error::success();
+  auto ToStart = importChecked(Err, S->getBeginLoc());
+  auto ToEnd = importChecked(Err, S->getEndLoc());
+  auto *ToAssociated = importChecked(Err, S->getAssociatedStmt());
+  if (Err)
+    return std::move(Err);
+
+  SmallVector<OMPClause *, 4> ToClauses;
+  if (Error E = ImportOMPClauses(S, ToClauses))
+    return std::move(E);
+
+  return OMPSingleDirective::Create(Importer.getToContext(), ToStart, ToEnd,
+                                    ToClauses, ToAssociated);
+}
