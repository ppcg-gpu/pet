+  auto ToEnd = importChecked(Err, S->getEndLoc());
+  auto *ToAssociated = importChecked(Err, S->getAssociatedStmt());
+  auto *ToTaskRed = importChecked(Err, S->getTaskReductionRefExpr());
+  if (Err)
