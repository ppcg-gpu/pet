+
+ExpectedStmt ASTNodeImporter::VisitOMPForDirective(OMPForDirective *S) {
+  Error Err = Error::success();
+  auto ToStart = importChecked(Err, S->getBeginLoc());
+  auto ToEnd = importChecked(Err, S->getEndLoc());
+  auto *ToAssociated = importChecked(Err, S->getAssociatedStmt());
+  auto *ToTaskRed = importChecked(Err, S->getTaskReductionRefExpr());
+  if (Err)
+    return std::move(Err);
+
+  SmallVector<OMPClause *, 4> ToClauses;
+  if (Error E = ImportOMPClauses(S, ToClauses))
+    return std::move(E);
+
+  // The expressions the loop was taken apart into.  A worksharing loop
+  // is generated from these and not from the loop as it was written, so
+  // a directive carried without them is a loop that generates nothing.
+  OMPLoopDirective::HelperExprs Exprs;
+  Exprs.clear(S->getLoopsNumber());
+
+  auto one = [&](Expr *From, Expr *&To) -> Error {
+    if (!From)
+      return Error::success();
+    ExpectedExpr ToOrErr = import(From);
+    if (!ToOrErr)
+      return ToOrErr.takeError();
+    To = *ToOrErr;
+    return Error::success();
+  };
+  auto many = [&](ArrayRef<Expr *> From,
+                  SmallVectorImpl<Expr *> &To) -> Error {
+    // clear() above sized these to the number of loops and filled them
+    // with nothing; what is carried replaces that rather than following
+    // it.
+    To.clear();
+    for (Expr *E : From) {
+      Expr *ToE = nullptr;
+      if (Error Er = one(E, ToE))
+        return Er;
+      To.push_back(ToE);
+    }
+    return Error::success();
+  };
+
+  struct { Expr *From; Expr **To; } singles[] = {
+    {S->getIterationVariable(), &Exprs.IterationVarRef},
+    {S->getLastIteration(), &Exprs.LastIteration},
+    {S->getNumIterations(), &Exprs.NumIterations},
+    {S->getPreCond(), &Exprs.PreCond},
+    {S->getCond(), &Exprs.Cond},
+    {S->getInit(), &Exprs.Init},
+    {S->getInc(), &Exprs.Inc},
+    {S->getIsLastIterVariable(), &Exprs.IL},
+    {S->getLowerBoundVariable(), &Exprs.LB},
+    {S->getUpperBoundVariable(), &Exprs.UB},
+    {S->getStrideVariable(), &Exprs.ST},
+    {S->getEnsureUpperBound(), &Exprs.EUB},
+    {S->getNextLowerBound(), &Exprs.NLB},
+    {S->getNextUpperBound(), &Exprs.NUB},
+  };
+  for (auto &P : singles)
+    if (Error E = one(P.From, *P.To))
+      return std::move(E);
+
+  if (Error E = many(S->counters(), Exprs.Counters))
+    return std::move(E);
+  if (Error E = many(S->private_counters(), Exprs.PrivateCounters))
+    return std::move(E);
+  if (Error E = many(S->inits(), Exprs.Inits))
+    return std::move(E);
+  if (Error E = many(S->updates(), Exprs.Updates))
+    return std::move(E);
+  if (Error E = many(S->finals(), Exprs.Finals))
+    return std::move(E);
+  if (Error E = many(S->dependent_counters(), Exprs.DependentCounters))
+    return std::move(E);
+  if (Error E = many(S->dependent_inits(), Exprs.DependentInits))
+    return std::move(E);
+  if (Error E = many(S->finals_conditions(), Exprs.FinalsConditions))
+    return std::move(E);
+
+  if (Stmt *FromPreInits = S->getPreInits()) {
+    ExpectedStmt ToPreInitsOrErr = import(FromPreInits);
+    if (!ToPreInitsOrErr)
+      return ToPreInitsOrErr.takeError();
+    Exprs.PreInits = *ToPreInitsOrErr;
+  }
+
+  return OMPForDirective::Create(Importer.getToContext(), ToStart, ToEnd,
+                                 S->getLoopsNumber(), ToClauses, ToAssociated,
+                                 Exprs, ToTaskRed, S->hasCancel());
+}
