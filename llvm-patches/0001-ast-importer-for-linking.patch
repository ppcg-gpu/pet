+// The body of an OpenMP region is held in a CapturedDecl, which is a
+// function in all but name: it has parameters, a body, and a context of
+// its own.
+ExpectedDecl ASTNodeImporter::VisitCapturedDecl(CapturedDecl *D) {
+  DeclContext *DC, *LexicalDC;
+  if (Error Err = ImportDeclContext(D, DC, LexicalDC)) {
+    llvm::errs() << "a captured region refuses at its context\n";
+    llvm::errs().flush();
+    return std::move(Err);
+  }
+
+  CapturedDecl *ToCD;
+  if (GetImportedOrCreateDecl(ToCD, D, Importer.getToContext(), DC,
+                              D->getNumParams()))
+    return ToCD;
+
+  ToCD->setLexicalDeclContext(LexicalDC);
+  LexicalDC->addDeclInternal(ToCD);
+
+  for (unsigned I = 0; I != D->getNumParams(); ++I) {
+    Expected<ImplicitParamDecl *> ToParamOrErr = import(D->getParam(I));
+    if (!ToParamOrErr) {
+      llvm::errs() << "a captured region refuses at parameter " << I << "\n";
+      llvm::errs().flush();
+      return ToParamOrErr.takeError();
+    }
+    if (I == D->getContextParamPosition())
+      ToCD->setContextParam(I, *ToParamOrErr);
+    else
+      ToCD->setParam(I, *ToParamOrErr);
+  }
+
+  ToCD->setNothrow(D->isNothrow());
+
+  ExpectedStmt ToBodyOrErr = import(D->getBody());
+  if (!ToBodyOrErr) {
+    ASTImportError::ErrorKind K = ASTImportError::Unknown;
+    handleAllErrors(ToBodyOrErr.takeError(),
+                    [&](const ASTImportError &IE) { K = IE.Error; });
+    llvm::errs() << "a captured region refuses at its body, a "
+                 << D->getBody()->getStmtClassName() << ", of kind "
+                 << (int)K << "\n";
+    llvm::errs().flush();
+    return make_error<ASTImportError>(K);
+  }
+  ToCD->setBody(*ToBodyOrErr);
+
+  return ToCD;
+}
