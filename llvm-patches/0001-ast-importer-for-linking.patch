+  auto *ToCD = importChecked(Err, S->getCapturedDecl());
+  auto *ToRD = importChecked(Err, const_cast<RecordDecl *>(
+                                      S->getCapturedRecordDecl()));
+  auto *ToInner = importChecked(Err, S->getCapturedStmt());
+  if (Err)
+    return std::move(Err);
+
+  SmallVector<CapturedStmt::Capture, 4> ToCaptures;
+  for (const CapturedStmt::Capture &From : S->captures()) {
+    ExpectedSLoc ToLocOrErr = import(From.getLocation());
+    if (!ToLocOrErr)
+      return ToLocOrErr.takeError();
+    VarDecl *ToVar = nullptr;
+    if (From.capturesVariable() || From.capturesVariableByCopy() ||
+        From.capturesVariableArrayType()) {
+      Expected<VarDecl *> ToVarOrErr = import(From.getCapturedVar());
+      if (!ToVarOrErr)
+        return ToVarOrErr.takeError();
+      ToVar = *ToVarOrErr;
+    }
+    ToCaptures.push_back(
+        CapturedStmt::Capture(*ToLocOrErr, From.getCaptureKind(), ToVar));
+  }
+
+  SmallVector<Expr *, 4> ToInits;
+  for (Expr *FromInit : S->capture_inits()) {
+    if (!FromInit) {
+      ToInits.push_back(nullptr);
+      continue;
+    }
+    ExpectedExpr ToInitOrErr = import(FromInit);
+    if (!ToInitOrErr)
+      return ToInitOrErr.takeError();
+    ToInits.push_back(*ToInitOrErr);
+  }
+
+  return CapturedStmt::Create(Importer.getToContext(), ToInner,
+                              S->getCapturedRegionKind(), ToCaptures, ToInits,
+                              ToCD, ToRD);
+}
+
+// The clauses of an OpenMP directive.  Only the ones that are met are
+// carried: a clause carried wrongly is worse than a clause refused,
+// because the refusal is said out loud and the wrong carry is not.
+Expected<OMPClause *> ASTNodeImporter::ImportOMPClause(OMPClause *C) {
+  Error Err = Error::success();
+
+  if (auto *From = dyn_cast<OMPNumThreadsClause>(C)) {
+    auto *ToNum = importChecked(Err, From->getNumThreads());
+    auto *ToHelper = importChecked(Err, From->getPreInitStmt());
+    auto ToStart = importChecked(Err, From->getBeginLoc());
+    auto ToLParen = importChecked(Err, From->getLParenLoc());
+    auto ToModifier = importChecked(Err, From->getModifierLoc());
+    auto ToEnd = importChecked(Err, From->getEndLoc());
+    if (Err)
+      return std::move(Err);
+    return new (Importer.getToContext()) OMPNumThreadsClause(
+        From->getModifier(), ToNum, ToHelper, From->getCaptureRegion(),
+        ToStart, ToLParen, ToModifier, ToEnd);
+  }
+
+  if (auto *From = dyn_cast<OMPReductionClause>(C)) {
+    auto ToStart = importChecked(Err, From->getBeginLoc());
+    auto ToLParen = importChecked(Err, From->getLParenLoc());
+    auto ToModifierLoc = importChecked(Err, From->getModifierLoc());
+    auto ToColon = importChecked(Err, From->getColonLoc());
+    auto ToEnd = importChecked(Err, From->getEndLoc());
+    auto ToQualifier = importChecked(Err, From->getQualifierLoc());
+    auto *ToPreInit = importChecked(Err, From->getPreInitStmt());
+    auto *ToPostUpdate = importChecked(Err, From->getPostUpdateExpr());
+    if (Err)
+      return std::move(Err);
+
+    auto ToNameLoc = importChecked(Err, From->getNameInfo().getLoc());
+    auto ToName = importChecked(Err, From->getNameInfo().getName());
+    if (Err)
+      return std::move(Err);
+
+    DeclarationNameInfo ToNameInfo(ToName, ToNameLoc);
+    if (Error E = ImportDeclarationNameLoc(From->getNameInfo(), ToNameInfo))
+      return std::move(E);
+
+    auto carry = [&](ArrayRef<Expr *> Exprs,
+                     SmallVectorImpl<Expr *> &Out) -> Error {
+      for (Expr *E : Exprs) {
+        if (!E) {
+          Out.push_back(nullptr);
+          continue;
+        }
+        ExpectedExpr ToEOrErr = import(E);
+        if (!ToEOrErr)
+          return ToEOrErr.takeError();
+        Out.push_back(*ToEOrErr);
+      }
+      return Error::success();
+    };
+
+    SmallVector<Expr *, 4> Vars, Privates, LHS, RHS, Ops, CopyOps;
+    SmallVector<Expr *, 4> CopyTemps, CopyElems;
+    if (Error E = carry(From->varlist(), Vars))
+      return std::move(E);
+    if (Error E = carry(From->privates(), Privates))
+      return std::move(E);
+    if (Error E = carry(From->lhs_exprs(), LHS))
+      return std::move(E);
+    if (Error E = carry(From->rhs_exprs(), RHS))
+      return std::move(E);
+    if (Error E = carry(From->reduction_ops(), Ops))
+      return std::move(E);
+    // The three lists below are only allocated for an inscan reduction;
+    // for any other kind the clause ends after the reduction operations,
+    // and asking for them reads past it.
+    if (From->getModifier() == OMPC_REDUCTION_inscan) {
+      if (Error E = carry(From->copy_ops(), CopyOps))
+        return std::move(E);
+      if (Error E = carry(From->copy_array_temps(), CopyTemps))
+        return std::move(E);
+      if (Error E = carry(From->copy_array_elems(), CopyElems))
+        return std::move(E);
+    }
+
+    SmallVector<bool, 4> Flags(From->private_var_reduction_flags().begin(),
+                               From->private_var_reduction_flags().end());
+
+    return OMPReductionClause::Create(
+        Importer.getToContext(), ToStart, ToLParen, ToModifierLoc, ToColon,
+        ToEnd, From->getModifier(), Vars, ToQualifier, ToNameInfo, Privates,
+        LHS, RHS, Ops, CopyOps, CopyTemps, CopyElems, ToPreInit, ToPostUpdate,
+        Flags, From->getOriginalSharingModifier());
+  }
+
+  if (auto *From = dyn_cast<OMPScheduleClause>(C)) {
+    auto ToStart = importChecked(Err, From->getBeginLoc());
+    auto ToLParen = importChecked(Err, From->getLParenLoc());
+    auto ToKindLoc = importChecked(Err, From->getScheduleKindLoc());
+    auto ToComma = importChecked(Err, From->getCommaLoc());
+    auto ToEnd = importChecked(Err, From->getEndLoc());
+    auto ToM1Loc = importChecked(Err, From->getFirstScheduleModifierLoc());
+    auto ToM2Loc = importChecked(Err, From->getSecondScheduleModifierLoc());
+    auto *ToChunk = importChecked(Err, From->getChunkSize());
+    auto *ToHelper = importChecked(Err, From->getPreInitStmt());
+    if (Err)
+      return std::move(Err);
+    return new (Importer.getToContext()) OMPScheduleClause(
+        ToStart, ToLParen, ToKindLoc, ToComma, ToEnd, From->getScheduleKind(),
+        ToChunk, ToHelper, From->getFirstScheduleModifier(), ToM1Loc,
+        From->getSecondScheduleModifier(), ToM2Loc);
+  }
+
+  llvm::errs() << "the clause " << getOpenMPClauseName(C->getClauseKind())
+               << " has no case in the importer\n";
+  llvm::errs().flush();
+  return make_error<ASTImportError>(ASTImportError::UnsupportedConstruct);
+}
+
+Error ASTNodeImporter::ImportOMPClauses(OMPExecutableDirective *From,
+                                        SmallVectorImpl<OMPClause *> &To) {
+  for (OMPClause *C : From->clauses()) {
+    Expected<OMPClause *> ToCOrErr = ImportOMPClause(C);
+    if (!ToCOrErr)
+      return ToCOrErr.takeError();
+    To.push_back(*ToCOrErr);
+  }
+  return Error::success();
+}
